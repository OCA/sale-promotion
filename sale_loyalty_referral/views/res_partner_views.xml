<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.referral</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Referral" name="referral">
                    <button
                        name="ensure_referral_code"
                        string="Generate Referral Code"
                        type="object"
                        class="btn-primary"
                        invisible="referral_code"
                    />
                    <field name="referral_code" readonly="1" />
                    <field name="referral_url" widget="url" />
                    <field
                        name="referral_count"
                        widget="statinfo"
                        string="Referred Customers"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
