<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_inherit_discount" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='coupon_settings']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field
                            name="automatically_apply_promo_code_discount_percentage"
                        />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="automatically_apply_promo_code_discount_percentage"
                            string="Automatically Apply Promo Code Discount Percentage"
                        />
                        <div class="text-muted" id="sale_coupon">
                            Automatically apply promo code discount percentage to each sale order line
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
